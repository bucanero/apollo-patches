set [b]:or:1F1F001F
set [b]:and:FFFFE0FF
write at 0x2C8:[b]
write at 0x2CE:1E
set [b]:read(0x2D2,4)
set [b]:or:1F1F1F00
set [b]:and:FFFFFFE0
write at 0x2D2:[b]
set [b]:read(0x2D6,4)
set [b]:or:1F1F001F
set [b]:and:FFFFE0FF
write at 0x2D6:[b]
