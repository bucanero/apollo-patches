set [b]:read(0x2F2,4)
set [b]:or:1F1F001F
set [b]:and:FFFFE0FF
write at 0x2F2:[b]
write at 0x2F8:1E
set [b]:read(0x2FC,4)
set [b]:or:1F1F1F00
set [b]:and:FFFFFFE0
write at 0x2FC:[b]
set [b]:read(0x300,4)
set [b]:or:1F1F001F
set [b]:and:FFFFE0FF
write at 0x300:[b]
write at 0x306:1E
set [b]:read(0x30A,4)
set [b]:or:1F1F1F00
