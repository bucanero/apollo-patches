set [b]:read(0x31C,4)
set [b]:or:1F1F001F
set [b]:and:FFFFE0FF
write at 0x31C:[b]

[All Gold Medals (All Characters)]
;Skate Park (+7), Burnside (+A), Roswell (+C): medal bits 5-7 set to gold (0x20), bits 0-4 kept so the tape count stays valid
set [b]:read(0x28F,4)
set [b]:and:1FFFFF1F
set [b]:or:20000020
write at 0x28F:[b]
set [b]:read(0x294,1)
set [b]:and:1F
set [b]:or:20
write at 0x294:[b]
