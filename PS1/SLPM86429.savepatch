; SLPM86429
; Tony Hawk's Skateboarding
; codes by bucanero, offsets from game-tools-collection save editor

:B?SLPM-86429*

; Career records: 11 characters, 0xE bytes each, base 0x288 + c*0xE
; +0 tape count, +4/+5/+6/+8/+9/+B goal bits 0-4, +7/+A/+C competition medal (0x20 gold)

[All Tapes and Goals (All Characters)]
;sets goal bits 0-4 on the 6 levels, clears bits 0-4 of the Skate Park and Burnside medal bytes
;(the game counts them too), then writes the matching tape count 30 (0x1E)
write at 0x288:1E
set [b]:read(0x28C,4)
set [b]:or:1F1F1F00
set [b]:and:FFFFFFE0
write at 0x28C:[b]
set [b]:read(0x290,4)
set [b]:or:1F1F001F
set [b]:and:FFFFE0FF
write at 0x290:[b]
write at 0x296:1E
set [b]:read(0x29A,4)
set [b]:or:1F1F1F00
set [b]:and:FFFFFFE0
write at 0x29A:[b]
set [b]:read(0x29E,4)
set [b]:or:1F1F001F
set [b]:and:FFFFE0FF
write at 0x29E:[b]
write at 0x2A4:1E
set [b]:read(0x2A8,4)
set [b]:or:1F1F1F00
set [b]:and:FFFFFFE0
write at 0x2A8:[b]
