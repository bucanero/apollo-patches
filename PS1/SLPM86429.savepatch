[LE:Max High Score (1st Place, All Courses)]
;999,999 points, record 0x324 + course*0x60, score at +8
2000032C 000F423F
2000038C 000F423F
200003EC 000F423F
2000044C 000F423F
200004AC 000F423F
2000050C 000F423F
2000056C 000F423F
200005CC 000F423F
2000062C 000F423F

[Update Checksum (Required)]
;sum of (byte + 1) over 0x280..0xC7F = byte sum + 0xA00, low 16 bits stored little-endian at 0x236
carry(0)
set [csum]:0
set [csum]:add(0x280,0xC7F)
set [csum]:[csum]+0xA00
set [sum16]:right([csum],2)
set [sum16]:endian_swap
write at 0x236:[sum16]
