[LE:SeeD Rank A]
;rank 3100 (SeeD level 31)
10000EF0 00000C1C

[Update FF8 Checksum (Required)]
;CRC-16 0x1021 with the game's table (entry 0xFF = 0) over 0x1D0..0x151F, stored at 0x180 and 0x1520
set range:0x1D0,0x151F
set [c]:ffx_checksum
write at 0x180:[c]
write at 0x1520:[c]
