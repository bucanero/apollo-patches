; SLPS02364
; Chrono Cross
; codes by bucanero, offsets from game-tools-collection save editor

:B?SLPSP02364*

[INFO:Also select the checksum update code at the end of this list, it is not applied automatically]

{WF}0000=Arnian Wood;0001=Simple Line;0002=Shellfish;0003=Skullduggery;0004=Tropical Paradise;0005=Snakes & Orbs;0006=Porre's Furnace;0007=Valencian Cloth;0008=Quill and Papyrus;0009=Iron Plate;000A=Monster's Mouth;000B=Infrared Vision;000C=Tea For Three;000D=Our Favorite Martian;000E=Guldovian Stitch{/WF}

[LE:Max Gold 999,999,999]
;0x58C, and its copy in the save preview at 0x3B
2000058C 3B9AC9FF
2000003B 3B9AC9FF

[99 Stars]
;star level (0x5A4, preview copy 0x3F) and current stars (0x5A5)
000005A4 00000063
000005A5 00000063
0000003F 00000063

[Recruit All Characters]
;44 bits at 0x590, one per character
write at 0x590:FFFFFFFFFF
set [b]:read(0x595,1)
set [b]:or:0F
write at 0x595:[b]

[All Key Items]
write at 0x180:FFFFFFFFFFFF
set [b]:read(0x186,2)
set [b]:or:1F70
write at 0x186:[b]

[All Window Frames]
set [b]:read(0x1F15,2)
set [b]:or:FF7F
write at 0x1F15:[b]

[Window Frame]
;the frame is shown when Config > Window is set to Custom (see next code)
000001CC 0000{WF}

[Use Custom Window Frame]
;option byte 0x5A0 bit 3
set [b]:read(0x5A0,1)
set [b]:or:08
write at 0x5A0:[b]

[New Game+ Flag]
set [b]:read(0x42,1)
set [b]:or:02
write at 0x42:[b]

[Max HP 999 (All Characters)]
;HP, Max HP and its copy: 44 x 10-bit fields each, packed at 0x1B04, 0x1B3B, 0x1B72
write at 0x1B04:E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9
write at 0x1B3B:E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9
write at 0x1B72:E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9E79F7FFEF9

[Max Stats 99 (All Characters)]
;Str, Acc, Res, Agi, MagPow, MagRes and their copies: 44 x 7-bit fields each, packed
;the third copy of each stat (unknown purpose) is left untouched
write at 0x16E4:E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7
set [b]:read(0x1757,1)
set [b]:and:0F
set [b]:or:30
write at 0x1757:[b]
set [b]:read(0x17A4,1)
set [b]:and:F0
set [b]:or:0C
write at 0x17A4:[b]
write at 0x1758:1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F178
write at 0x17CB:E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7
set [b]:read(0x183E,1)
set [b]:and:0F
set [b]:or:30
write at 0x183E:[b]
set [b]:read(0x188B,1)
set [b]:and:F0
set [b]:or:0C
write at 0x188B:[b]
write at 0x183F:1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F178
write at 0x18B2:E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7
set [b]:read(0x1925,1)
set [b]:and:0F
set [b]:or:30
write at 0x1925:[b]
write at 0x1926:1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7
set [b]:read(0x1D2F,1)
set [b]:and:F0
set [b]:or:0C
write at 0x1D2F:[b]
write at 0x1D09:E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F1783C1E8FC7E3F178

[All Items x99 (Replaces Inventory)]
;205 item IDs (9-bit, 0x5AC) and quantities (7-bit, 0x75C), packed
write at 0x5AC:
write at 0x75C:

[All Elements x99 (Replaces Element Inventory)]
;element IDs 0x01-0x7E (9-bit, 0x8AC) and quantities (7-bit, 0x984), packed
write at 0x8AC:
write at 0x984:

[Update Byte-Sum Checksum (Required)]
;u32 sum of bytes 0x0000..0x1FF7, stored little-endian at 0x1FFC
carry(0)
set [v]:0
set [v]:add(0x0,0x1FF7)
set [v]:endian_swap
write at 0x1FFC:[v]
