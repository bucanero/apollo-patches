set [b]:or:01
write at 0x3CC:[b]
set [b]:read(0x3F8,1)
set [b]:or:01
write at 0x3F8:[b]
set [b]:read(0x424,1)
set [b]:or:01
write at 0x424:[b]
set [b]:read(0x450,1)
set [b]:or:01
write at 0x450:[b]
set [b]:read(0x47C,1)
set [b]:or:01
write at 0x47C:[b]
set [b]:read(0x4A8,1)
set [b]:or:01
write at 0x4A8:[b]
set [b]:read(0x4D4,1)
set [b]:or:01
write at 0x4D4:[b]
set [b]:read(0x500,1)
set [b]:or:01
write at 0x500:[b]
set [b]:read(0x52C,1)
set [b]:or:01
write at 0x52C:[b]

[Game Cleared (Bonus Game: All Weapons, Unlimited Ammo)]
00000640 00000001

[All Weapons]
;bits 1-7 of +0x14 in every level-start record, including the one the saved game resumes from
set [b]:read(0x214,1)
set [b]:or:FE
write at 0x214:[b]
