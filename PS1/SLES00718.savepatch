; SLES00718
; Tomb Raider II
; codes by bucanero, offsets from game-tools-collection save editor

:B?SLES-00718*

[INFO:Also select the checksum update code at the end of this list, it is not applied automatically]

; 0x200 + n*0x2C: 24 level-start records (n = game level, 1 = The Great Wall)
;   +0x00 ammo u16 x7 (pistols, automatic pistols, uzi, shotgun, M16, grenades, harpoons)
;   +0x0E small medi, +0x0F large medi, +0x11 flares, +0x14 bit0 available, bits1-7 weapons
; 0x620 current level statistics, 0x634 current level, 0x640 bonus game flag

[Unlock All Levels]
;bit 0 of +0x14 in the records of levels 1-18
set [b]:read(0x240,1)
set [b]:or:01
write at 0x240:[b]
set [b]:read(0x26C,1)
set [b]:or:01
write at 0x26C:[b]
set [b]:read(0x298,1)
set [b]:or:01
write at 0x298:[b]
set [b]:read(0x2C4,1)
set [b]:or:01
write at 0x2C4:[b]
set [b]:read(0x2F0,1)
set [b]:or:01
write at 0x2F0:[b]
set [b]:read(0x31C,1)
set [b]:or:01
write at 0x31C:[b]
set [b]:read(0x348,1)
set [b]:or:01
write at 0x348:[b]
set [b]:read(0x374,1)
set [b]:or:01
write at 0x374:[b]
set [b]:read(0x3A0,1)
set [b]:or:01
write at 0x3A0:[b]
