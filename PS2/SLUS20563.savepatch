:BASLUS-20563DOTHACK

[Update Byte-Sum Checksum (Required)]
;for each slot NN (entry E = (NN-1)*0x1C): f = used flag at E, d = sum computed this run.
;the u16 LE sum lands at E+0x12+2*(f+d): only f=d=1 reaches E+0x16, the checksum.
;E+0x12..0x15 is saved first and restored after, so f+d < 2 changes nothing.
;d is cleared after use, so a stale sum from an earlier run is never written again.
;slot 01
set [f]:read(0x0,1)
set [f]:and:01
set [k]:read(0x12,4)
set [v]:right([s01],2)
set [v]:endian_swap
set pointer:0x12
set pointer:[f]+[f]+pointer+[d01]+[d01]
write next (0):[v]
write at 0x12:[k]
set [d01]:00
;slot 02
set [f]:read(0x1C,1)
set [f]:and:01
set [k]:read(0x2E,4)
set [v]:right([s02],2)
set [v]:endian_swap
set pointer:0x2E
set pointer:[f]+[f]+pointer+[d02]+[d02]
write next (0):[v]
write at 0x2E:[k]
set [d02]:00
