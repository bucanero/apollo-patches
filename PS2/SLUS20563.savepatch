; SLUS20563
; .hack//Part 3 - Outbreak
; codes by bucanero, offsets from game-tools-collection save editor
;
; 12 save slots = files dhdata01..dhdata12 (0x8530 or 0x8D84 bytes, same layout up to 0x8530).
; Slot NN checksum = sum of all bytes of dhdataNN & 0xFFFF, stored u16 LE in the system
; file (named like the save folder) at (NN-1)*0x1C+0x16, next to the slot's 'used' flag at +0x00.
; Every cheat edits the dhdata file you pick. The Required codes then sum all 12 dhdata files
; and write each sum back for every used slot, so no slot has to be chosen twice.

:dhdata*

[INFO:Pick the same file for every cheat: dhdata01-12 = save slot 1-12]
[INFO:Checksums of all used slots are rebuilt by the Required codes]

[LE:Max GP (9,999,999)]
2000749C 0098967F

[LE:Kite Level 99]
10007496 00000063

[LE:Kite Max HP 9999 / Max SP 999]
100074AC 0000270F
100074AE 000003E7

[Kite All Stats 999]
;phys atk/def/acc/eva, mag atk/def/acc/eva, 6 affinities, 2 condition resists: 16 x u16 LE
write at 0x74B0:E703E703E703E703E703E703E703E703E703E703E703E703E703E703E703E703

[Unlock All Servers]
;0x2234 bits 0-4 = Delta, Theta, Lambda, Sigma, Omega
set [b]:read(0x2234,1)
set [b]:or:1F
write at 0x2234:[b]

[99 of Every Virus Core (A-P)]
write at 0xCFC:63636363636363636363636363636363

[99 of Every Grunty Food]
write at 0xD16:63636363636363636363636363636363

[All Ryu Books (Book of 1000)]
;key items 0x111-0x118 = Ryu Book I-VIII
write at 0xE0D:0101010101010101

:dhdata01

[Compute Slot 01 Byte-Sum (Required)]
;[s01] = sum of every byte of dhdata01; [d01] = 1 marks it as computed in this run

set [s01]:0
set [s01]:add(0x0,eof)
set [d01]:01

