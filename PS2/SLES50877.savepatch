[Complete Story (All Difficulties) and All Cutscenes]
;Easy/Normal/Hard bits at 0x1AF8/0x1AFC/0x1B00 (10 levels), cutscenes at 0x1AF4 (13)
set pointer:0x{PSF}
set [b]:read(pointer+0x1AF4,2)
set [b]:or:FF1F
write next 0x1AF4:[b]
set [b]:read(pointer+0x1AF8,2)
set [b]:or:FF03
write next 0x1AF8:[b]
set [b]:read(pointer+0x1AFC,2)
set [b]:or:FF03
write next 0x1AFC:[b]
set [b]:read(pointer+0x1B00,2)
set [b]:or:FF03
write next 0x1B00:[b]

[Complete Co-op Story (All Difficulties)]
;co-op Easy/Normal/Hard bits at 0x1B04/0x1B08/0x1B0C
set pointer:0x{PSF}
set [b]:read(pointer+0x1B04,2)
set [b]:or:FF03
write next 0x1B04:[b]
set [b]:read(pointer+0x1B08,2)
set [b]:or:FF03
write next 0x1B08:[b]
set [b]:read(pointer+0x1B0C,2)
set [b]:or:FF03
write next 0x1B0C:[b]

[All Arcade Awards]
;58 award bytes at 0x1AB8..0x1AF1, bit 0
set pointer:0x{PSF}
set [b]:read(pointer+0x1AB8,4)
set [b]:or:01010101
write next 0x1AB8:[b]
set [b]:read(pointer+0x1ABC,4)
set [b]:or:01010101
