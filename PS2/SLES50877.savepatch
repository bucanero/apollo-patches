; SLES50877
; TimeSplitters 2
; codes by bucanero, offsets from game-tools-collection save editor

:BESLES-50877-TS2-OPT

; 16 profile slots of 0x20D4 bytes, profile i fields at <offset> + i*0x20D4 (profile count at 0x4).
; Every code asks for the profile; pick one that exists (profile names are shown in the game's profile menu).
; {PSF} is 5 hex digits wide because the last slot base (0x1EC6C) does not fit a 4-digit {SF} tag.
; Pointer writes use 'write next', which adds the pointer on every engine ('write at pointer+N' does not parse).
{PSF}00000=Profile 1;020D4=Profile 2;041A8=Profile 3;0627C=Profile 4;08350=Profile 5;0A424=Profile 6;0C4F8=Profile 7;0E5CC=Profile 8;106A0=Profile 9;12774=Profile 10;14848=Profile 11;1691C=Profile 12;189F0=Profile 13;1AAC4=Profile 14;1CB98=Profile 15;1EC6C=Profile 16{/PSF}

[Unlock All (Platinum Medals in Arcade League and Challenges)]
;medal bit blocks Bronze/Silver/Gold/Platinum at 0x1B10/0x1B20/0x1B30/0x1B40: bits 0-20 challenges, 21-65 arcade matches
;these bits are what unlock characters, cheats, modes, hats and levels
;then award = 4 (Platinum) at +0xC of the 66 records at 0x13CC + k*0x14 (21 challenges, 45 arcade matches), play count bit 0 set
set pointer:0x{PSF}
write next 0x1B10:FFFFFFFFFFFFFFFF
set [b]:read(pointer+0x1B18,1)
set [b]:or:03
write next 0x1B18:[b]
write next 0x1B20:FFFFFFFFFFFFFFFF
set [b]:read(pointer+0x1B28,1)
set [b]:or:03
write next 0x1B28:[b]
write next 0x1B30:FFFFFFFFFFFFFFFF
set [b]:read(pointer+0x1B38,1)
set [b]:or:03
write next 0x1B38:[b]
write next 0x1B40:FFFFFFFFFFFFFFFF
set [b]:read(pointer+0x1B48,1)
set [b]:or:03
write next 0x1B48:[b]
