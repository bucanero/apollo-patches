set [b]:or:0101
write next 0x1AF0:[b]

[Unlock Mini-Games (Anaconda, RetroRacer, AstroLander)]
;bit 0 of 0x2258, 0x225C, 0x2264 (0x2260 is unknown and left alone)
set pointer:0x{PSF}
set [b]:read(pointer+0x2258,1)
set [b]:or:01
write next 0x2258:[b]
set [b]:read(pointer+0x225C,1)
set [b]:or:01
write next 0x225C:[b]
set [b]:read(pointer+0x2264,1)
set [b]:or:01
write next 0x2264:[b]

[Update CRC-32 Checksum (Required)]
;zlib CRC-32 over 0x4..0x20F4F, stored little-endian at 0x20F50
set range:0x4,0x20F4F
set [crc]:crc32
set [crc]:endian_swap
write at 0x20F50:[crc]
