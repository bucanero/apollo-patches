; SLPM67502
; Devil May Cry
; codes & checksum fix by bucanero, offsets from game-tools-collection save editor

:BISLPM-67502

[Unlock all difficulties and costumes]
0000000B 000000FF

[Update Checksum for System Data (Required)]
;DMC1 System Checksum: 32-bit byte sum of 0x04..0x103
;write value as little-endian

set [csum]:0
set [csum]:add(0x000004,0x103)
set [csum]:endian_swap
write at 0x000000:[csum]


:SaveData-0*

[INFO:Also select the checksum update code at the end of this list, it is not applied automatically]

; some code offset/values from https://github.com/joaovitorbf/dmcsaveeditor
; difficulty settings
{DS}0001=Easy Automatic;0003=Normal;0005=Hard;0007=Dante Must Die{/DS}
{CH}0000=Dante;0001=Legendary Dark Knight;0002=Super Dante{/CH}

[Max Vitality Bar]
00000624 00000063

[Max Devil Trigger Bar]
00000625 00000063

[LE:Total Red Orbs 99999 Collected]
2000083C 0001869F

[All Difficulties-All Stages-Rank S]
420007BC 00000000
40110004 00000000
00000800 00000000

[LE:999,999 Max Red Orbs]
20000634 000F423F

[99 Max Blue Orbs]
00000638 00000063

[LE:999 Max Yellow Orbs]
10000620 000003E7

[LE:Game Beaten 999 Times]
10000022 000003E7

[LE:Playtime 0:00:01]
2000002C 00000001

[LE:Total Save Count 1]
10000020 00000001

[Change Difficulty]
00000026 0000{DS}

; current mission 0-22
[Current Mission: last mission 23]
00000024 00000016

[Learn All Alastor and Ifrit Skills]
;Ifrit 0x62A bits 1-7, Alastor 0x62B bits 0-6
set [b]:read(0x62A,2)
set [b]:or:FE7F
write at 0x62A:[b]

[All Secret Missions Cleared]
;SM6-9,12 = 0x32 bits 3-7, SM1-5,10,11 = 0x33 bits 0-6
set [b]:read(0x32,2)
set [b]:or:F87F
write at 0x32:[b]

[All Enemy Files]
;20 u32 part masks from 0x6BC, one bit per file part
write at 0x6BC:7F0000007F0000007F000000FF0F0000FF0100007F000000FF0000003F0000007F00000007000000FF000000FF030000FF01000003000000FF0000001F000000FF030000FF3F00007F00000001000000

[Max Combo Rankings]
;Dull/Cool/Bravo/Absolute/Stylish u32 at 0x4D8..0x4E8 = 99,999
write at 0x4D8:9F8601009F8601009F8601009F8601009F860100

[Select Character]
;requires the character to be unlocked in the system file
00000027 0000{CH}

[Update Checksum for SaveData-0X (Required)]
;DMC1 SaveData Checksum: 32-bit byte sum of 0x0C..0x96F
;write value as little-endian

set [csum]:0
set [csum]:add(0x00000C,0x96F)
set [csum]:endian_swap
write at 0x000008:[csum]
