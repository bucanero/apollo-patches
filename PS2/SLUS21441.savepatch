; SLUS21441
; DragonBall Z - Budokai Tenkaichi 2
; codes by bucanero, offsets from game-tools-collection save editor

:BASLUS-21441DBZT2

; Z-item records at 0x1F30 + idx*4: u16 flags (the game writes 0003 for owned items), u16 quantity.
; Same layout in all four regions (US/EU/JP/KR samples differ only in the options byte at 0x1008).

[LE:Max Zeni (9,999,999)]
2000283C 0098967F

[Unlock All Characters]
;Z-items 0x1AE..0x22E (129 characters), records 0x25E8..0x27EB set to owned, quantity 1
write at 0x25E8:

[Unlock All Dragon Adventure Sagas]
;saga Z-items 0x186..0x19C (0x2548..0x25A3) and 0x19E Destined Rivals (0x25A8), quantity 1
write at 0x2548:0300010003000100030001000300010003000100030001000300010003000100030001000300010003000100030001000300010003000100030001000300010003000100030001000300010003000100030001000300010003000100
write at 0x25A8:03000100

[All Dragon Adventure Stages Level 3]
;one rank byte per stage at 0x0C..0xD3 (200 stages)
write at 0x000C:

[999 of All Z-Items (Ability, Support, Fusion)]
;320 Z-items 0x000..0x15D (unused ids skipped), owned with quantity 999 (the editor maximum)
write at 0x1F30:
write at 0x20B0:
write at 0x21CC:
write at 0x22C0:0300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E703
write at 0x2334:0300E703
write at 0x233C:0300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E703
write at 0x2368:0300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E703
write at 0x239C:0300E7030300E703
write at 0x23B0:0300E7030300E7030300E7030300E7030300E7030300E7030300E703
write at 0x23DC:0300E7030300E703
write at 0x23F0:0300E7030300E703
write at 0x2400:0300E7030300E703
write at 0x2410:0300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E703
write at 0x2470:0300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E7030300E703
write at 0x249C:0300E7030300E7030300E703

[Update Word Sum Checksum (Required)]
;16-bit sum of little-endian words over 0x8..0x3FFF; high byte stored at 0x0, low byte at 0x4,
;each as a zero-extended u32

set [csum]:0
set [csum]:wadd_le(0x8,0x3FFF)
set [sum16]:right([csum],2)
write at 0x0:[sum16]
write at 0x3:[sum16]
write at 0x1:000000
write at 0x5:000000
