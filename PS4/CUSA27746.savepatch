:DGA*.SAV

; DGAZ_xx.SAV slot saves and DGAUTO.SAV autosave
; unpacked data starts at 0x68 (after the DGS header)

[python:Unpack Save data (Required)]
import demongaze

savedata = demongaze.dg_unpack(savedata)


