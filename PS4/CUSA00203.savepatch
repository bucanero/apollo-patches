[Group:\]

[Update inventory.zwei checksum (Required)]
set range:0x0004,EOF+1
set [hash]:md5_xor
write at 0x00:[hash]


:instance*.zwei

[Decompress instance*.zwei]
decompress(0, -15)


:~extracted\00000000.dat

; instance*.zwei cheats go here (decompressed data)


:instance*.zwei

[Compress instance*.zwei]
; trim the file, so it only holds the new deflate stream
delete at 4:EOF
compress(0)

[Update instance*.zwei checksum]
; tail = MD5_XOR of the last 0x20000-byte block of the deflate stream
set [start]:eof
set [start]:and:0xFFFE0000
set range:[start],EOF+1
set [tail]:md5_xor
set [tail]:endian_swap
insert at 7FFFFFFF:[tail]
